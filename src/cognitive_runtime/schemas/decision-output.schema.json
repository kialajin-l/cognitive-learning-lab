{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cognitive-runtime/decision-output/v1",
  "title": "Cognitive Runtime DecisionOutput",
  "description": "Layered result: raw model proposal, typed judgment, authorised output and writeback decision are separate objects. An abstain is a valid outcome, not a failure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "status", "selected", "final_answer", "abstain_reason",
    "raw_proposal", "memory_hit", "evidence_refs", "judgment", "verification",
    "writeback", "writeback_receipt", "authorization", "proposal_agrees_with_judgment",
    "cost", "model"
  ],
  "properties": {
    "schema_version": {"const": "cognitive-runtime/decision-output/v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["answered", "abstained"]},
    "selected": {"type": ["string", "null"]},
    "final_answer": {"type": ["string", "null"]},
    "abstain_reason": {"type": ["string", "null"]},
    "raw_proposal": {"type": "object"},
    "memory_hit": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "judgment": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["allow", "abstain"]},
        "selected": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "matched_rule_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["type", "scope"],
      "properties": {
        "type": {"type": "string"},
        "scope": {"type": "string"}
      }
    },
    "writeback": {"type": "object"},
    "writeback_receipt": {"type": "object"},
    "authorization": {"enum": ["verified_judgment", "none"]},
    "proposal_agrees_with_judgment": {"type": "boolean"},
    "cost": {
      "type": "object",
      "required": ["model_calls", "latency_ms"],
      "properties": {
        "model_calls": {"type": "integer"},
        "acquisition_calls": {"type": "integer"},
        "latency_ms": {"type": ["integer", "null"]},
        "prompt_tokens": {"type": ["integer", "null"]},
        "completion_tokens": {"type": ["integer", "null"]},
        "monetary_cost": {"type": ["number", "null"]}
      }
    },
    "model": {
      "type": "object",
      "required": ["provider_class", "model_id", "model_digest", "calibration_status"],
      "properties": {
        "provider_class": {"enum": ["mock", "real"]},
        "model_id": {"type": "string"},
        "model_digest": {"type": "string"},
        "calibration_status": {"type": "string"}
      }
    }
  }
}
